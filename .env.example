# Digital Heroes - Environment Variables

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Public & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (Test Mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Stripe Price IDs
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=price_monthly_placeholder
NEXT_PUBLIC_STRIPE_YEARLY_PRICE_ID=price_yearly_placeholder

# Platform Defaults (Configurable via platform_settings)
DEFAULT_CURRENCY=INR
DEFAULT_PRIZE_POOL_PERCENT=50
